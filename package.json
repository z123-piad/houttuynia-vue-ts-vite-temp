{
  "name": "houttuynia-vue-ts-vite-temp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{vue,ts,tsx}\" \"vite.config.ts\" \"uno.config.ts\" --fix",
    "lint:check": "eslint \"src/**/*.{vue,ts,tsx}\" \"vite.config.ts\" \"uno.config.ts\"",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,js,scss,css,json,md}\" \"*.{ts,js,cjs,json,md}\""
  },
  "dependencies": {
    "axios": "^1.7.8",
    "pinia": "^2.2.7",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.10.4",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@unocss/reset": "^66.10.5",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^13.0.0",
    "eslint": "^8.57.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-vue": "^9.31.0",
    "prettier": "^3.4.1",
    "sass": "^1.81.0",
    "typescript": "~5.6.2",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^0.18.5",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^6.0.1",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^2.1.10"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "author": "ban_sheng",
  "repository": "https://github.com/z123-piad/houttuynia-vue-ts-vite-temp.git"
}
