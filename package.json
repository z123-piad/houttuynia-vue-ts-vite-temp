{
  "name": "houttuynia-vue-ts-vite-temp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{vue,ts,tsx}\" \"vite.config.ts\" \"uno.config.ts\" --fix",
    "lint:check": "eslint \"src/**/*.{vue,ts,tsx}\" \"vite.config.ts\" \"uno.config.ts\"",
    "format": "prettier --write \"src/**/*.{vue,ts,tsx,js,scss,css,json,md}\" \"*.{ts,js,cjs,json,md,mjs}\""
  },
  "dependencies": {
    "@vue/devtools-api": "^8.2.1",
    "axios": "^1.20.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@unocss/reset": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^10.12.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "sass": "^1.105.1",
    "typescript": "~5.9.3",
    "unocss": "^66.10.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.4",
    "vite-plugin-svg-icons": "^2.0.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "author": "ban_sheng",
  "repository": "https://github.com/z123-piad/houttuynia-vue-ts-vite-temp.git"
}
